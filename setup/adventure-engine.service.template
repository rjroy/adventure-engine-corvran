# Adventure Engine of Corvran - systemd user service
#
# Generated by setup/install.sh. Do not edit the installed copy directly;
# re-run install.sh after changing the template or environment file.
#
# Logs:
#   journalctl --user -u adventure-engine -f

[Unit]
Description=Adventure Engine of Corvran
After=network.target

[Service]
Type=simple

# Secrets and per-machine config (PROJECT_DIR, API tokens)
EnvironmentFile={{CORVRAN_DIR}}/setup/adventure-engine.env

# Build frontend before starting the server
ExecStartPre=/usr/bin/env bash -c 'cd "{{CORVRAN_DIR}}/frontend" && bun run build'

# Run the backend (exec replaces the shell so systemd tracks the real process)
ExecStart=/usr/bin/env bash -c 'cd "{{CORVRAN_DIR}}/backend" && exec bun run start'

Restart=on-failure
RestartSec=5

# The backend handles SIGTERM gracefully (see backend/src/shutdown.ts)
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=adventure-engine

[Install]
WantedBy=default.target
