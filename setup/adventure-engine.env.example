# Adventure Engine environment configuration
#
# Copy this file to adventure-engine.env and fill in your values:
#   cp adventure-engine.env.example adventure-engine.env
#
# This file is loaded by the systemd service via EnvironmentFile.
# It is also sourced by rebg when restarting the service.

# Required: path to the adventure world directory
# This is where player characters, world state, and session data live.
PROJECT_DIR=/home/rjroy/Projects/Vaults/rowan-wyrd/adventures

# Server configuration (defaults shown)
#PORT=3000
#HOST=localhost

# API tokens
#ANTHROPIC_API_KEY=
#REPLICATE_API_TOKEN=
